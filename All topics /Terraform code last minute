Example 1: AWS EC2 VM (most common)
1️⃣ Provider
provider "aws" {
  region = "ap-south-1"
}

2️⃣ Security Group
resource "aws_security_group" "vm_sg" {
  name        = "vm-sg"
  description = "Allow SSH"

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

3️⃣ EC2 Instance
resource "aws_instance" "vm" {
  ami                    = "ami-0abcdef12345"   # explain: AMI ID
  instance_type          = "t2.micro"
  key_name               = "my-keypair"
  vpc_security_group_ids = [aws_security_group.vm_sg.id]

  tags = {
    Name = "terraform-vm"
  }
}

4️⃣ Output
output "instance_public_ip" {
  value = aws_instance.vm.public_ip
}
